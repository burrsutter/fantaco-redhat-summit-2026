# backup.env — Backup broker site (get-my-claw.com)
SITE_NAME=backup
BROKER_DOMAIN=get-my-claw.com
BROKER_S3_BUCKET=getmyclaw-route-lb-config
BROKER_EC2_TAG=route-lb-haproxy-backup
ALB_NAME=route-lb-alb-backup
TG_NAME=route-lb-backup-tg
HAPROXY_SG_NAME=route-lb-haproxy-backup
IAM_ROLE_NAME=route-lb-haproxy-backup

# LLM provider override (overrides .env when --site backup is used)
LLM_PROVIDER=gcp
GEMINI_MODEL=gemini-2.5-pro
