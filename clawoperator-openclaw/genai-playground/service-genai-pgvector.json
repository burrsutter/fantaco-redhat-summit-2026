  "kind": "Service",
  "metadata": {
    "labels": {
      "gen-ai.opendatahub.io/pgvector": "true"
    },
    "name": "genai-pgvector"
  },
  "spec": {
    "ports": [
      {
        "name": "postgresql",
        "port": 5432,
        "protocol": "TCP",
        "targetPort": 5432
