{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "labels": {
      "gen-ai.opendatahub.io/pgvector": "true"
    },
    "name": "genai-pgvector-storage"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "5Gi"
      }
    },
    "storageClassName": "gp3-csi",
    "volumeMode": "Filesystem"
  }
}