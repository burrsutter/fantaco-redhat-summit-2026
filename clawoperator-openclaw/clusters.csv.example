# clusters.csv — Define OpenShift clusters for multi-cluster broker
# Format: cluster_id,kubeconfig_path
# Lines starting with # are ignored
#
# cluster_id:      Short identifier (used in broker-sync output)
# kubeconfig_path:  Absolute path to the cluster's kubeconfig file
#
# Include the existing broker cluster and every new cluster. Use a separate,
# logged-in kubeconfig for each one. Replace the paths and uncomment both rows.
# Usage (from the broker cluster's oc context):
#   cp clusters.csv.example clusters.csv
#   ./update-broker-ocp.sh --rotate-status-key
#
# jzsjx,/absolute/path/kubeconfig-jzsjx
# NEWGUID,/absolute/path/kubeconfig-NEWGUID
