# FantaCo Environment Variables
# Copy to .env and fill in actual values

# OpenAI — used by fantaco-product-main/tools/generate_images.py
OPENAI_API_KEY=CHANGE_ME

# LLM Provider — determines which model backend OpenClaw uses
# Options: gcp (Vertex AI), litellm (OpenAI-compatible proxy), anthropic, openai
LLM_PROVIDER=gcp

# LLM (OpenAI-compatible) — used by sales-policy-search and hr-policy-search RAG services
LLM_API_KEY=CHANGE_ME
LLM_API_BASE_URL=https://litellm-prod.apps.maas.redhatworkshops.io
LLM_MODEL_NAME=qwen3-14b

# Embedding model for OpenClaw memory search (agents.defaults.memorySearch).
# Served on the same key and base URL as LLM_MODEL_NAME, so no extra credential.
#
# Leave empty to turn memory search OFF (post-restart-repatch.sh then writes
# memorySearch.enabled=false). Do not confuse "empty" with "unset in the config":
# unset makes OpenClaw fall back to the openai provider default
# (text-embedding-3-small), which a scoped MaaS key rejects with
# "openai embeddings failed: 401" every turn. The repatch script always writes
# one of the two explicit states, so empty is safe.
#
# Empty is also what makes chat-only MaaS keys usable: the seat never calls the
# embedder, so the key needs LLM_MODEL_NAME alone, and set-user-api-keys.sh drops
# the embedder from its scope check. The demo does not use vector recall — a full
# demo-flow-test scores 23/23 with memory search off, 4/4 on the notes-recall step.
LLM_EMBEDDING_MODEL=nomic-embed-text-v1-5

# Comma-separated fallback chain for the agent. Empty = no fallbacks. The
# operator otherwise seeds hosted OpenAI models that a scoped key 401s on,
# costing ~3s per turn and burying the real error under six auth failures.
LLM_FALLBACK_MODELS=

# ─── MaaS over MaaS ────────────────────────────────────────────────────────
# Used by maas-publish-model.sh and maas-mint-seat-keys.sh to re-publish an
# EXTERNAL RHDP MaaS model through THIS cluster's MaaS, so the seats get
# cluster-issued per-seat keys instead of everyone sharing one upstream key.
#
# Two credentials exist at two layers. Do not conflate them:
#
#   MAAS_UPSTREAM_API_KEY  the RHDP virtual key you already hold BEFORE the
#                          install. Lets this cluster call RHDP. You set it.
#   LLM_API_KEY            a key THIS cluster's MaaS issues. One per seat,
#                          minted by maas-mint-seat-keys.sh. Not set by hand.
#
# The RHDP virtual key. Required by maas-publish-model.sh, which stores it as
# secret qwen-upstream-maas in models-as-a-service and applies the label
# inference.llm-d.ai/ipp-managed=true. WITHOUT THAT LABEL every CR reports
# Ready, /v1/models lists the model, keys issue fine — and only the first real
# inference fails, with "authType 'apikey' credentials not found".
MAAS_UPSTREAM_API_KEY=CHANGE_ME

# FQDN ONLY — no scheme, no path. The CRD rejects "https://host/v1"; the /v1
# belongs in the ExternalModel path, not the provider endpoint.
MAAS_UPSTREAM_ENDPOINT=maas-rhdp.apps.maas.redhatworkshops.io

# Client-facing model name. Must match what the upstream actually serves.
MAAS_MODEL=qwen3-235b-a22b

# Token budget for the MaaSSubscription. This is FLEET-WIDE, not per seat:
# every seat key is minted under one identity and shares one subscription.
# Size it for the whole room, not for one attendee.
MAAS_TOKEN_LIMIT=50000000
MAAS_TOKEN_WINDOW=1h

# Expiry for the per-seat keys. The tenant maximum is reported by
# GET /v1/api-keys/config (max_expiration_days, default 90).
MAAS_KEY_EXPIRATION_DAYS=90

# OpenClaw gateway image. PIN THIS — do not leave it to the operator default.
# The Claw CR templates used to omit spec.image, so each namespace silently got
# whatever the operator handed out on the day it was created. That split one
# 50-user fleet across 2026.6.35-slim (users 1-22) and 2026.7.1-2 (users 23-50),
# and the 6.35-pinned diagnostics plugins the reset installs do not match a 7.1
# gateway. 2026.6.35 is the extended-stable line and the only build the demo
# flow, the trace pipeline and the skill-routing behaviour are validated against.
#
# This is a PATCHED 2026.6.35 (same upstream version, so no
# meta.lastTouchedVersion migration gate). It carries two dist patches to
# extensions/diagnostics-otel that the stock ghcr image does not:
#   preview4 — puts the prompt on the root span, so the MLflow Traces list
#              shows the request/response instead of a trace ID;
#   preview5 — suppresses the metric-free orphan telemetry spans
#              (openclaw.exec / liveness.warning / memory.pressure) that MLflow
#              renders as "null" rows, which were 58% of the list.
# Built from .state/otel-patch/preview5/ — see the README there to rebuild.
# Reverting to ghcr.io/openclaw/openclaw:2026.6.35-slim brings both back.
OPENCLAW_IMAGE=quay.io/bluesman/openclaw:2026.6.35-mlflow-preview7

# Anthropic — optional, used by OpenClaw gateway
ANTHROPIC_API_KEY=CHANGE_ME

# Telegram — used by OpenClaw gateway
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Telegram user ID — restricts bot access to your account only
# Find yours by messaging @userinfobot on Telegram
TELEGRAM_USER_ID=CHANGE_ME

# GCP Vertex AI — used when LLM_PROVIDER=gcp
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT=CHANGE_ME
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# OpenShift cluster
OPENSHIFT_CONSOLE_URL=https://console-openshift-console.apps.YOUR_CLUSTER.opentlc.com/

# Student Password
STUDENT_OPENCLAW_PASSWORD=CHANGE_ME
STUDENT_OPENSHIFT_PASSWORD=CHANGE_ME

# Admin User & Password
ADMIN_USER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# OpenClaw model server API key
MODEL_API_KEY=CHANGE_ME

# Langfuse — keys auto-loaded from .state/<cluster-guid>/langfuse.env
# (generated by deploy-traces-langfuse.sh, no manual config needed)

# Object store behind the LokiStack — read by deploy-logs-loki.sh.
#   s3   AWS S3 bucket + IAM user, created with the aws CLI. The default, and
#        what the script has always done. Leave this unset and nothing changes.
#   odf  OpenShift Data Foundation / NooBaa bucket, claimed in-cluster with an
#        ObjectBucketClaim. No AWS account, no aws CLI, nothing outside the
#        cluster that can expire underneath the demo.
# Use odf on any cluster that has ODF. A dead S3 bucket does not fail the
# LokiStack — it reports Ready while the ingesters drop every line with
# "The AWS Access Key Id you provided does not exist in our records", which is
# exactly how the AWS teardown went unnoticed.
LOKI_OBJECT_STORE=s3
